# Examples only; this file is not automatically loaded by Spring Boot or scripts.
# Vite API proxy target (set in the frontend process environment if needed).
API_PROXY_TARGET=http://127.0.0.1:8080

# PostgreSQL settings remain in backend/src/main/resources/application.yaml.
# This root file is not automatically loaded by Spring Boot.
# Do not copy real credentials into this example.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_PREFIX=banking.dev
BANKING_KAFKA_ENABLED=true
        

# Optional Gemini chatbot. Backend only; never use a VITE_ variable for the key.
GEMINI_API_KEY=gen-lang-client-0331953999
GEMINI_MODEL=gemini-3.5-flash-lite

# Docker Compose reads .env automatically. run.bat / run.sh generate secrets
# when .env does not exist. Do not replace an existing .env used by data volumes.
# For manual setup replace ALL three empty values with random secrets.
DOCKER_DB_PASSWORD=
# Base64 encoding of at least 32 random bytes (scripts generate 64 bytes).
DOCKER_JWT_SECRET=
DOCKER_ADMIN_PASSWORD=
DOCKER_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Optional external AI chatbot; empty key uses the built-in fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Native development only: Spring Boot does NOT automatically load root .env.
# Export these in the backend process environment (or use local properties).
# DB_URL=jdbc:postgresql://localhost:5432/banking_db
# DB_USERNAME=banking_app
# DB_PASSWORD=
# MIGRATION_DB_USERNAME=banking_owner
# MIGRATION_DB_PASSWORD=
# JWT_SECRET=
# SERVER_ADDRESS=127.0.0.1
# SERVER_PORT=8080
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_NAMESPACE=banking:dev
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# KAFKA_TOPIC_PREFIX=banking.dev
# BANKING_KAFKA_ENABLED=true
# BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BANKING_SECURITY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend dev only: use frontend/.env or export in the frontend process.
# API_PROXY_TARGET=http://127.0.0.1:8080
# VITE_API_BASE_URL=/api/v1
